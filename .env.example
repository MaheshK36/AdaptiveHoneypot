APP_ENV=development
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://honeypot:change_me@db:5432/honeypot
API_HOST=0.0.0.0
API_PORT=8000
SESSION_ROOT=/tmp/honeypot_sessions
LOG_DIR=/var/log/honeypot
EVIDENCE_DIR=/var/log/honeypot/evidence
EVENT_INGEST_URL=http://backend:8000/events
EVENT_INGEST_TIMEOUT=2
FAKE_HTTP_PORT=8080
FAKE_HTTP_BIND_ADDRESS=0.0.0.0
FAKE_HTTP_SERVER_HEADER=nginx
FAKE_HTTP_CONTENT_ROOT=/srv/fake-http
FAKE_HTTP_SESSIONS_ROOT=/srv/fake-http/sessions
FAKE_DB_PORT=3306
FAKE_DB_BIND_ADDRESS=0.0.0.0
FAKE_DB_HOST=fake-db
FAKE_DB_SESSION_ROOT=/sessions
FAKE_DB_MAX_SESSIONS=1000
COWRIE_PORT=2222
COWRIE_INTERNAL_PORT=2222
COWRIE_UID=999
COWRIE_GID=999
COWRIE_LOG_UMASK=0002
COWRIE_SESSION_DATA_ROOT=/sessions
COWRIE_JSON_LOG_PATH=/var/log/honeypot/cowrie.json
COWRIE_HONEYPOT_VAR_PATH=/var/log/honeypot/cowrie-state
BACKEND_API_URL=http://backend:8000
COLLECTOR_POLL_INTERVAL=0.2
COLLECTOR_MAX_LINE_BYTES=262144
COLLECTOR_MAX_MAPPINGS=10000
COLLECTOR_HEARTBEAT_MAX_AGE=30
HONEYPOT_BIND_ADDRESS=127.0.0.1
HONEYPOT_INTERNAL_SUBNET=172.21.0.0/16
HONEYPOT_INTERNAL_GATEWAY=172.21.0.1
HONEYPOT_EXPOSED_SUBNET=172.22.0.0/16
HONEYPOT_EXPOSED_GATEWAY=172.22.0.1
HONEYPOT_EXPOSED_BRIDGE_NAME=br-honeypot
